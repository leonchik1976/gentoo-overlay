# Configuration for aistor.service. Set credentials before starting.
# https://docs.min.io/aistor/reference/aistor-server/settings/
MINIO_LICENSE=/etc/aistor/aistor.license
MINIO_VOLUMES="/var/lib/aistor/data"
MINIO_OPTS="--address :9000 --console-address :9001"
#MINIO_ROOT_USER=change-me
#MINIO_ROOT_PASSWORD=change-me-before-starting

# Storage paths outside /var/lib/aistor require a systemd drop-in:
# systemctl edit aistor.service
# [Service]
# ReadWritePaths=/srv/aistor-data
# Keep ProtectSystem=strict. Create the storage directories and grant the
# aistor account traversal and read/write access before starting the service.
# ReadWritePaths= permits writes through the sandbox; it does not grant Unix
# permissions or expose paths hidden by ProtectHome=true (such as /home).
