#!/bin/sh
# Read only the environment supplied by systemd; never source aistor.env.
for credential in "${MINIO_ROOT_USER-}" "${MINIO_ROOT_PASSWORD-}"; do
	case "${credential}" in
		""|minioadmin|change-me|change-me-before-starting)
			printf '%s\n' 'AIStor: set non-default MINIO_ROOT_USER and MINIO_ROOT_PASSWORD in /etc/aistor/aistor.env.' >&2
			exit 1
			;;
	esac
done
