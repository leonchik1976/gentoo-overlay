Use PEP 639 license metadata without changing the shipped license text.
Keep the explicit license file and require a backend that understands SPDX.

--- a/setup.cfg
+++ b/setup.cfg
@@ -13,7 +13,7 @@
 long_description_content_type = text/x-rst
 author = Andrew Svetlov <andrew.svetlov@gmail.com>
 author_email = andrew.svetlov@gmail.com
-license = Apache 2
+license_expression = Apache-2.0
 license_files = LICENSE
 classifiers = 
 	Development Status :: 5 - Production/Stable
@@ -22,8 +22,6 @@
 	
 	Intended Audience :: Developers
 	
-	License :: OSI Approved :: Apache Software License
-	
 	Operating System :: POSIX
 	Operating System :: MacOS :: MacOS X
 	Operating System :: Microsoft :: Windows
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,3 +1,3 @@
 [build-system]
-requires = ["setuptools>=51", "wheel>=0.36"]
+requires = ["setuptools>=77.0.3", "wheel>=0.36"]
 build-backend = "setuptools.build_meta"
