# The above dependency-closure license list is a best-effort audit at the
# PyPI metadata level (License classifiers, PEP 639 license_expression /
# short license fields, and well-established public knowledge for a
# handful of very common packages lacking either) across all 241 vendored
# runtime dependencies -- see scripts/generate-open-webui-wheel-deps.py
# and the accompanying packaging report. It is NOT a byte-level source
# audit of every bundled native library the way dev-util/semgrep-bin's
# LICENSE comment is (that covered ~30 bundled .so files; this bundles
# 241 independent PyPI packages, several of which themselves bundle their
# own further native code, e.g. torch, onnxruntime, opencv-python-headless
# -- auditing each of those to that same depth was not attempted here).
# Treat this as reasonably reliable but not exhaustively verified.

SLOT="0"
KEYWORDS="~amd64 ~arm64"
REQUIRED_USE="${PYTHON_REQUIRED_USE} elibc_glibc"

# `strip`: the compiled native extensions inside several vendored wheels
# (torch, onnxruntime, numpy, scipy, tokenizers, pyarrow, ...) are
# manylinux-repaired prebuilt binaries whose bundled shared libraries and
# symbol-versioning metadata Portage's default `strip` pass can corrupt,
# the same failure mode documented in dev-util/semgrep-bin for its one
# prebuilt binary.
#
# `mirror`: NOT a license concern -- the Open WebUI License's clauses 1-2
# (see licenses/Open-WebUI) explicitly permit redistribution "in source
# and binary forms", and every one of the 241 vendored dependencies'
# licenses (see the LICENSE comment above) is a standard OSS license that
# permits redistribution too, so nothing here is legally restricted from
# being mirrored. The reason is purely practical: this vendors ~2GB of
# large prebuilt binary wheels (see scripts/generate-open-webui-wheel-deps.py)
# individually fetched straight from files.pythonhosted.org, which
# already serves them from a CDN -- pushing another ~2GB copy of already-
# well-distributed upstream binaries through Gentoo's own distfile mirror
# network would just be redundant load on that shared infrastructure for
# no real availability benefit, the same practical (not license-driven)
# reasoning under which large prebuilt binary blobs are conventionally
# kept off Gentoo's mirror tier elsewhere in the tree. This is a personal
# overlay with no mirror tier of its own today, so this RESTRICT is inert
# in practice right now; it is kept so the ebuild states the correct
# intent if this overlay (or these files) ever end up mirrored.
RESTRICT="mirror strip"

pkg_setup() {
	[[ ${OPEN_WEBUI_WHEEL_DEPS_VERSION} == ${PV} ]] ||
		die "OPEN_WEBUI_WHEEL_DEPS_VERSION (${OPEN_WEBUI_WHEEL_DEPS_VERSION}) does not match PV (${PV}); the pasted-in dependency arrays were generated for a different version"

	python-single-r1_pkg_setup
}

RDEPEND="
	${PYTHON_DEPS}
	>=sys-libs/glibc-2.28
	acct-group/open-webui
	acct-user/open-webui
"
BDEPEND+="
	${PYTHON_DEPS}
	$(python_gen_cond_dep '
		dev-python/pip[${PYTHON_USEDEP}]
	')
"

# The vendored wheels bundle their own compiled native extensions
# (manylinux-repaired, self-contained); leave them exactly as installed
# by pip rather than letting QA machinery try to "fix" them.
QA_PREBUILT="usr/lib*/open-webui/site-packages/*"

src_install() {
	local sitedir="${ED}/usr/$(get_libdir)/open-webui/site-packages"
	mkdir -p "${sitedir}" || die

	local wheels=() entry filename
	for entry in "${OPEN_WEBUI_WHEELS_COMMON[@]}"; do
		filename=${entry##*|}
		[[ ${filename} == *.whl ]] || die "non-wheel dependency in install set: ${filename}"
		wheels+=( "${DISTDIR}/${filename}" )
	done
	if use amd64; then
		for entry in "${OPEN_WEBUI_WHEELS_AMD64[@]}"; do
			filename=${entry##*|}
			[[ ${filename} == *.whl ]] || die "non-wheel dependency in install set: ${filename}"
			wheels+=( "${DISTDIR}/${filename}" )
		done
	fi
	if use arm64; then
		for entry in "${OPEN_WEBUI_WHEELS_ARM64[@]}"; do
			filename=${entry##*|}
			[[ ${filename} == *.whl ]] || die "non-wheel dependency in install set: ${filename}"
			wheels+=( "${DISTDIR}/${filename}" )
		done
	fi
	wheels+=( "${DISTDIR}/${OPEN_WEBUI_MAIN_WHEEL}" )

	# --no-index/--no-deps/local paths only: every wheel is already fetched
	# into DISTDIR by Portage, and the full dependency closure was
	# pre-resolved by scripts/generate-open-webui-wheel-deps.py, so this
	# performs no network access and no dependency resolution of its own.
	#
	PIP_NO_INDEX=1 PIP_NO_CACHE_DIR=1 PIP_NO_INPUT=1 \
	PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_ROOT_USER_ACTION=ignore \
	PIP_PROGRESS_BAR=off \
	"${EPYTHON}" -m pip install \
		--no-index --no-deps --no-compile \
		--target "${sitedir}" \
		"${wheels[@]}" || die "pip install of vendored wheels failed"

	# Validate every active dependency requirement in the private target
	# offline. distributions(path=[sitedir]) deliberately excludes system
	# Python distributions, so they cannot mask missing vendored wheels.
	"${EPYTHON}" -S - "${sitedir}" <<-'PY' || die "private dependency metadata check failed"
		from importlib.metadata import distributions
		from pathlib import Path
		import sys

		sitedir = Path(sys.argv[1])
		sys.path.insert(0, str(sitedir))
		from packaging.markers import default_environment
		from packaging.requirements import Requirement
		from packaging.utils import canonicalize_name
		from packaging.version import Version

		dists = list(distributions(path=[sitedir]))
		installed = {}
		for dist in dists:
		    name = canonicalize_name(dist.metadata["Name"])
		    if name in installed:
		        raise SystemExit(f"duplicate private distribution metadata for {name}")
		    installed[name] = (Version(dist.version), dist)
		if "opencv-python" in installed:
		    raise SystemExit("unexpected private opencv-python GUI distribution")
		env = default_environment()
		problems = []
		for _, dist in installed.values():
		    for raw in dist.requires or ():
		        req = Requirement(raw)
		        if req.marker and not req.marker.evaluate(env):
		            continue
		        found = installed.get(canonicalize_name(req.name))
		        if found is None:
		            problems.append(f"{dist.metadata['Name']} requires missing {req}")
		        elif req.specifier and found[0] not in req.specifier:
		            problems.append(f"{dist.metadata['Name']} requires {req}, found {found[0]}")
		if problems:
		    raise SystemExit("\n".join(problems))
		print(f"private dependency metadata check: {len(installed)} distributions satisfied")
	PY

	# pip's --target mode installs package files but not console_scripts
	# wrapper scripts (unlike a normal prefix/venv install); write the one
	# entry point this package actually needs by hand instead. Confirmed
	# via the wheel's own dist-info/entry_points.txt:
	#   [console_scripts]
	#   open-webui = open_webui:app
	# where `open_webui.app` is a typer.Typer() instance (callable).
	cat > "${T}/open-webui" <<-EOF || die
		#!/usr/bin/env ${EPYTHON}
		import sys
		sys.path.insert(0, "${EPREFIX}/usr/$(get_libdir)/open-webui/site-packages")
		from open_webui import app
		if __name__ == "__main__":
		    sys.exit(app())
	EOF
	python_newscript "${T}/open-webui" open-webui

	newinitd "${FILESDIR}/open-webui.initd" open-webui
	newconfd "${FILESDIR}/open-webui.confd" open-webui
	# WEBUI_SECRET_KEY and any backend API keys set in this file are
	# secrets (see the file's own header comment); newconfd's default
	# mode leaves it world-readable, which contradicts that comment.
	fperms 0600 /etc/conf.d/open-webui
	systemd_newunit "${FILESDIR}/open-webui.service" open-webui.service

	keepdir /var/lib/open-webui
	fowners open-webui:open-webui /var/lib/open-webui
	fperms 0750 /var/lib/open-webui
}
