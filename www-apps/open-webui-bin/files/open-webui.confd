# open-webui environment. Keep this file readable only by root: WEBUI_SECRET_KEY
# and any backend API keys configured through it are secrets.

OPEN_WEBUI_HOST="127.0.0.1"
OPEN_WEBUI_PORT="8080"

# Persisted database/uploads/config directory; matches acct-user/open-webui's
# home directory and this service's WorkingDirectory.
DATA_DIR="/var/lib/open-webui"

# Set a long, random value before putting open-webui into production; unset,
# it auto-generates and persists one under DATA_DIR on first run.
# WEBUI_SECRET_KEY=""

# Point at an Ollama or OpenAI-compatible backend.
# OLLAMA_BASE_URL="http://127.0.0.1:11434"
# OPENAI_API_BASE_URL="https://api.openai.com/v1"
# OPENAI_API_KEY=""
