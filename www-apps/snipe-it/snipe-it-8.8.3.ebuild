# Application, locked production libraries, and bundled frontend assets.
LICENSE="AGPL-3+ Apache-2.0 BSD-2 BSD ISC MIT GPL-2+ LGPL-3+
	BitstreamVera GPL-2-with-font-exception GPL-3+-with-font-exception
	CC-BY-4.0 OFL-1.1"
KEYWORDS="~amd64 ~arm64"

PHP_USE="bcmath,cli,ctype,curl,exif,fileinfo,filter,gd,iconv,jpeg(+),mysql,mysqli,pdo,png(+)"
PHP_USE+=",session,simplexml,sodium,ssl,tokenizer,truetype,unicode,xml,zip,zlib"
PHP_DEPS="|| (
	dev-lang/php:8.5[${PHP_USE}]
	dev-lang/php:8.4[${PHP_USE}]
	dev-lang/php:8.3[${PHP_USE}]
	dev-lang/php:8.2[${PHP_USE}]
)"
BDEPEND+="
	${PHP_DEPS}
	>=dev-php/composer-2.2
	app-arch/unzip
"
RDEPEND+="
|| (
	( dev-lang/php:8.5[${PHP_USE}] virtual/httpd-php:8.5 )
	( dev-lang/php:8.4[${PHP_USE}] virtual/httpd-php:8.4 )
	( dev-lang/php:8.3[${PHP_USE}] virtual/httpd-php:8.3 )
	( dev-lang/php:8.2[${PHP_USE}] virtual/httpd-php:8.2 )
)"

src_unpack() {
	# Composer archives are consumed directly from DISTDIR, not unpacked here.
	unpack "${P}.tar.gz"
}

src_prepare() {
	default
	local slot
	for slot in 8.5 8.4 8.3 8.2; do
		if has_version -b "dev-lang/php:${slot}[${PHP_USE}]"; then
			SNIPEIT_PHP="${BROOT}/usr/bin/php${slot}"
			break
		fi
	done
	[[ -n ${SNIPEIT_PHP} ]] || die "No suitable PHP CLI slot"
	# Persist the chosen executable across phase environments.
	printf '%s\n' "${SNIPEIT_PHP}" > "${T}/php" || die
	cp composer.lock "${T}/composer.lock" || die
	"${SNIPEIT_PHP}" "${FILESDIR}/local-dist.php" "${DISTDIR}" || die
}

src_compile() {
	local php
	read -r php < "${T}/php" || die
	export COMPOSER_HOME="${T}/composer-home"
	export COMPOSER_CACHE_DIR="${T}/composer-cache"
	export COMPOSER_DISABLE_NETWORK=1
	"${php}" "${BROOT}/usr/bin/composer" --no-interaction --no-plugins --no-scripts \
		install --no-dev --prefer-dist --optimize-autoloader || die
	"${php}" "${BROOT}/usr/bin/composer" --no-plugins --no-scripts \
		check-platform-reqs --no-dev || die
	# Explicit offline subset of upstream's post-autoload-dump scripts.
	"${php}" artisan package:discover --ansi || die
	"${php}" artisan vendor:publish --force --tag=livewire:assets --ansi || die
	"${php}" artisan --version || die
	cp "${T}/composer.lock" composer.lock || die
}

src_install() {
	webapp_src_preinst
	insinto "${MY_HTDOCSDIR}"
	doins -r app bootstrap config database public resources routes storage vendor
	doins artisan composer.json composer.lock .env.example
	newins .env.example .env
	# This path is required on Gentoo for the application's backup commands.
	sed -i 's|^DB_DUMP_PATH=.*|DB_DUMP_PATH=/usr/bin|' "${D}${MY_HTDOCSDIR}/.env" || die
	fperms 0640 "${MY_HTDOCSDIR}/.env"
	webapp_configfile "${MY_HTDOCSDIR}/.env"
	webapp_serverowned -R "${MY_HTDOCSDIR}/storage" \
		"${MY_HTDOCSDIR}/public/uploads" "${MY_HTDOCSDIR}/bootstrap/cache"
	webapp_postinst_txt en "${FILESDIR}/postinstall-en.txt"
	webapp_postupgrade_txt en "${FILESDIR}/postinstall-en.txt"
	dodoc README.md LICENSE
	webapp_src_install
}

src_test() {
	local php
	read -r php < "${T}/php" || die
	"${php}" "${FILESDIR}/smoke-test.php" || die
}

pkg_postinst() {
	elog "Deploy manually with webapp-config; serve only the public/ subdirectory."
	elog "Read /usr/share/webapps/${PN}/${SLOT}/postinst-en.txt before setup/upgrades."
	optfeature "LDAP integration (enable on your chosen PHP slot)" "dev-lang/php[ldap]"
	optfeature "database backup/restore client utilities" "virtual/mysql"
	webapp_pkg_postinst
}
