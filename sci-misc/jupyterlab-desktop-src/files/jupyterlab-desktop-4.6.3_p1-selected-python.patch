From: Leonid Kopylov <leonchik1976@gmail.com>
Subject: [PATCH] Launch the selected POSIX Python without requiring activation

A system interpreter has no activation script, and its executable need not be
PATH's python. Quote the selected path as a literal shell argument, and source
only existing activation scripts. Keep virtualenv and conda activation when
available, including activation through the base conda environment.

Upstream: https://github.com/jupyterlab/jupyterlab-desktop/blob/v4.6.3-1/src/main/server.ts

--- a/src/main/server.ts
+++ b/src/main/server.ts
@@ -32,6 +32,10 @@
 const SERVER_LAUNCH_TIMEOUT = 30000; // milliseconds
 const SERVER_RESTART_LIMIT = 3; // max server restarts
 
+function quoteShellArg(value: string): string {
+  return "'" + value.replace(/'/g, "'\\''") + "'";
+}
+
 function createLaunchScript(
   serverInfo: JupyterServer.IInfo,
   baseCondaEnvPath: string,
@@ -44,7 +48,11 @@
   // note: traitlets<5.0 require fully specified arguments to
   // be followed by equals sign without a space; this can be
   // removed once jupyter_server requires traitlets>5.0
-  const launchArgs = ['python', '-m', 'jupyterlab'];
+  const launchArgs = [
+    isWin ? 'python' : quoteShellArg(serverInfo.environment.path),
+    '-m',
+    'jupyterlab'
+  ];
 
   const strPort = port.toString();
 
@@ -129,16 +137,16 @@
   } else {
     if (isConda) {
       script = `
-        source "${condaActivatePath}"
+        ${fs.existsSync(condaActivatePath) ? `source ${quoteShellArg(condaActivatePath)}` : ''}
         ${
-          isBaseCondaActivate
-            ? `source ${condaShellScriptPath} && conda activate "${envPath}"`
+          isBaseCondaActivate && fs.existsSync(condaShellScriptPath)
+            ? `source ${quoteShellArg(condaShellScriptPath)} && conda activate ${quoteShellArg(envPath)}`
             : ''
         }
         ${launchCmd}`;
     } else {
       script = `
-        source "${envActivatePath}"
+        ${fs.existsSync(envActivatePath) ? `source ${quoteShellArg(envActivatePath)}` : ''}
         ${launchCmd}`;
     }
   }
