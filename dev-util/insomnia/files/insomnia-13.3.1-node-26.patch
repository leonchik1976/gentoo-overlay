Allow locally validated Node 26 builds alongside upstream's Node 24.

This is an overlay compatibility change, not a claim of upstream Node 26
support. Keep the guard restricted to the two locally validated majors.

--- a/packages/insomnia/scripts/build.ts
+++ b/packages/insomnia/scripts/build.ts
@@ -20,8 +20,8 @@ export const start = async () => {
 
   console.log(`[build] node: ${process.version}`.trim());
 
-  if (process.version.indexOf('v24.') !== 0) {
-    console.log('[build] Node 24.x.x is required to build');
+  if (!/^v(?:24|26)\./.test(process.version)) {
+    console.log('[build] Node 24.x.x or 26.x.x is required to build');
     process.exit(1);
   }
 
