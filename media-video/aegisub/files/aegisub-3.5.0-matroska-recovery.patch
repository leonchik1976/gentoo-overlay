-  bad = 0;
+  // The mutable scan cursor and failed-attempt count must survive errors.
+  // Establish one checkpoint so loop housekeeping also has a valid handler.
+  (void)setjmp(mf->jb);
 
   while (pos < mf->pSegmentTop) {
     if (!mf->cache->progress(mf->cache,pos,mf->pSegmentTop))
@@ -2543,9 +2558,6 @@
       break;
 
     pos = next_cluster + 4; // prevent endless loops
-
-    if (setjmp(mf->jb)) // something evil happened while reindexing
-      continue;
 
     seek(mf,next_cluster);
 
@@ -2605,6 +2617,9 @@
     bad = 0;
   }
 
+  // Cue finalization must not jump back into the completed scan on OOM.
+  memcpy(&mf->jb,&jb,sizeof(jb));
+
   fixupCues(mf);
 
   if (mf->nCues == 0) {
@@ -2616,8 +2631,6 @@
   }
 
   mf->cache->progress(mf->cache,0,0);
-
-  memcpy(&mf->jb,&jb,sizeof(jb));
 }
 
