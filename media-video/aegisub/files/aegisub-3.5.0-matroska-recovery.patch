+)
+test('matroska recovery', matroska_recovery, timeout: 10)
diff --git a/tests/tests/matroska_recovery.c b/tests/tests/matroska_recovery.c
--- /dev/null
+++ b/tests/tests/matroska_recovery.c
@@ -0,0 +1,217 @@
+/* Regression tests for the bundled parser's private recovery paths.
+ * Synthetic EBML containers avoid external files and GUI dependencies.
+ * SPDX-License-Identifier: MIT
+ * Copyright 2026 Leonid Kopylov
+ */
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include "../../src/MatroskaParser.c"
+
+#define CHECK(expr) do { \
+  if (!(expr)) { \
+    fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #expr); \
+    exit(EXIT_FAILURE); \
+  } \
+} while (0)
+
+struct TestStream {
+  InputStream io;
+  MatroskaFile mf;
+  unsigned char data[8192];
+  size_t size;
+  unsigned reads, scans, progress_calls, reallocs;
+  unsigned read_chunk;
+  int fail_alloc;
+  uint64_t last_scan, positions[512];
+};
+
+static int test_read(InputStream *io, uint64_t pos, void *buffer, int count) {
+  struct TestStream *s = (struct TestStream *)io;
+  CHECK(++s->reads < 1000);
+  if (pos >= s->size) return 0;
+  if ((uint64_t)count > s->size - pos) count = (int)(s->size - pos);
+  if (s->read_chunk && (unsigned)count > s->read_chunk) count = (int)s->read_chunk;
+  if (buffer) memcpy(buffer, s->data + pos, (size_t)count);
+  return count;
+}
+
+static int64_t test_scan(InputStream *io, uint64_t start, unsigned signature) {
+  struct TestStream *s = (struct TestStream *)io;
+  uint64_t i;
+  CHECK(++s->scans < 500);
+  CHECK(s->scans == 1 || start > s->last_scan);
+  s->last_scan = start;
+  for (i = start; i + 4 <= s->size; ++i) {
+    unsigned value = (unsigned)s->data[i] << 24 | (unsigned)s->data[i+1] << 16 |
+                     (unsigned)s->data[i+2] << 8 | s->data[i+3];
+    if (value == signature) return (int64_t)i;
+  }
+  return -1;
+}
+
+static unsigned test_cache_size(InputStream *io) { (void)io; return 8192; }
+static const char *test_error(InputStream *io) { (void)io; return "test I/O error"; }
+static void *test_alloc(InputStream *io, size_t n) { (void)io; return malloc(n); }
+static void *test_realloc(InputStream *io, void *ptr, size_t n) {
+  struct TestStream *s = (struct TestStream *)io;
+  ++s->reallocs;
+  return s->fail_alloc ? NULL : realloc(ptr, n);
+}
+static void test_free(InputStream *io, void *ptr) { (void)io; free(ptr); }
+static int test_progress(InputStream *io, uint64_t pos, uint64_t max) {
+  struct TestStream *s = (struct TestStream *)io;
+  if (max) {
+    CHECK(s->progress_calls < 512);
+    s->positions[s->progress_calls++] = pos;
+  }
+  return 1;
+}
+
+static struct TestStream *make_stream(const unsigned char *data, size_t size) {
+  struct TestStream *s = calloc(1, sizeof(*s));
+  CHECK(s && size <= sizeof(s->data));
+  memcpy(s->data, data, size);
+  s->size = size;
+  s->io.read = test_read;
+  s->io.scan = test_scan;
+  s->io.getcachesize = test_cache_size;
+  s->io.geterror = test_error;
+  s->io.memalloc = test_alloc;
+  s->io.memrealloc = test_realloc;
+  s->io.memfree = test_free;
+  s->io.progress = test_progress;
+  s->mf.cache = &s->io;
+  s->mf.pSegment = s->mf.pCluster = s->mf.readPosition = 1;
+  s->mf.pSegmentTop = size;
+  s->mf.Seg.TimecodeScale = 1;
+  return s;
+}
+
+static void release_stream(struct TestStream *s) {
+  free(s->mf.Cues);
+  free(s);
+}
+
+static void check_blocks(const unsigned char *data, size_t size, int expected,
+                         unsigned scans, uint64_t position, int error) {
+  struct TestStream *s = make_stream(data, size);
+  if (setjmp(s->mf.jb)) CHECK(!"unexpected escape from readMoreBlocks");
+  CHECK(readMoreBlocks(&s->mf) == expected);
+  CHECK(s->scans == scans);
+  CHECK(s->mf.readPosition == position);
+  CHECK(!!(s->mf.flags & MPF_ERROR) == error);
+  if (expected != EOF) CHECK(s->mf.tcCluster == 7);
+  release_stream(s);
+}
+
+static void test_blocks(void) {
+  static const unsigned char valid[] = {0, 0x1f,0x43,0xb6,0x75,0x83,0xe7,0x81,7};
+  static const unsigned char corrupt[] = {0, 0, 0x1f,0x43,0xb6,0x75,0x83,0xe7,0x81,7};
+  /* BlockGroup before Timecode is invalid: recover at the next cluster. */
+  static const unsigned char block[] = {0, 0x1f,0x43,0xb6,0x75,0x82,0xa0,0x80,
+                                         0x1f,0x43,0xb6,0x75,0x83,0xe7,0x81,7};
+  static const unsigned char truncated_id[] = {0, 0x1f,0x43,0xb6,0x75,0x83,0x1f};
+  static const unsigned char truncated_size[] = {0, 0x1f,0x43,0xb6,0x75,0x40};
+  static const unsigned char oversized[] = {0, 0, 0x1f,0x43,0xb6,0x75,0x14,0,0,0,
+                                             0x1f,0x43,0xb6,0x75,0x83,0xe7,0x81,7};
+  static const unsigned char exhausted[] = {0, 0x1f,0x43,0xb6,0x75,0,
+                                             0x1f,0x43,0xb6,0x75,0,
+                                             0x1f,0x43,0xb6,0x75,0,
+                                             0x1f,0x43,0xb6,0x75,0,
+                                             0x1f,0x43,0xb6,0x75,0x83,0xe7,0x81,7};
+  check_blocks(valid, sizeof(valid), 0, 0, sizeof(valid), 0);
+  check_blocks(corrupt, sizeof(corrupt), RBRESYNC, 1, sizeof(corrupt), 0);
+  check_blocks(block, sizeof(block), RBRESYNC, 1, sizeof(block), 0);
+  check_blocks(truncated_id, sizeof(truncated_id), EOF, 0, sizeof(truncated_id), 1);
+  check_blocks(truncated_size, sizeof(truncated_size), EOF, 0, sizeof(truncated_size), 1);
+  check_blocks(oversized, sizeof(oversized), RBRESYNC, 2, sizeof(oversized), 0);
+  check_blocks(exhausted, sizeof(exhausted), EOF, 3, 21, 1);
+  puts("readMoreBlocks: 7 valid/corrupt/truncated/retry-limit cases OK");
+}
+
+static void test_reindex_limit(void) {
+  unsigned char data[1000] = {0};
+  struct TestStream *s;
+  unsigned i;
+  for (i = 1; i < 501; i += 5) memcpy(data+i, "\x1f\x43\xb6\x75\0", 5);
+  s = make_stream(data, sizeof(data));
+  if (setjmp(s->mf.jb)) CHECK(!"unexpected escape from reindex");
+  reindex(&s->mf);
+  unsigned skipped = 0;
+  for (i = 1; i < s->progress_calls; ++i)
+    if (s->positions[i] == s->positions[i-1] + (sizeof(data)-1)/10) ++skipped;
+  CHECK(skipped == 1); /* step over data after 50 unsuccessful candidates */
+  CHECK(s->scans < 101 && s->scans > 50);
+  CHECK(s->mf.nCues == 1 && s->mf.Cues[0].Position == 0);
+  release_stream(s);
+  puts("reindex: malformed candidates preserve 50-attempt skip and forward progress OK");
+}
+
+static void test_reindex_cue(void) {
+  unsigned char data[1040] = {0};
+  struct TestStream *s;
+  /* An invalid-size candidate, then a 1024-byte cluster and another header. */
+  memcpy(data+1, "\x1f\x43\xb6\x75\0", 5);
+  memcpy(data+6, "\x1f\x43\xb6\x75\x44\0\xe7\x81\x02", 9);
+  memcpy(data+1036, "\x1f\x43\xb6\x75", 4);
+  s = make_stream(data, sizeof(data));
+  if (setjmp(s->mf.jb)) CHECK(!"unexpected escape while indexing a valid cluster");
+  reindex(&s->mf);
+  CHECK(s->mf.nCues == 1);
+  CHECK(s->mf.Cues[0].Time == 2 && s->mf.Cues[0].Position == 5);
+  release_stream(s);
+  puts("reindex: recovery retains a valid following cue OK");
+}
+
+static void test_reindex_oom(void) {
+  unsigned char data[64] = {0};
+  struct TestStream *s;
+  memcpy(data+1, "\x1f\x43\xb6\x75\0", 5);
+  s = make_stream(data, sizeof(data));
+  s->fail_alloc = 1;
+  if (!setjmp(s->mf.jb)) {
+    reindex(&s->mf);
+    CHECK(!"fallback allocation failure must reach the caller");
+  }
+  CHECK(s->reallocs == 1 && s->scans == 2);
+  CHECK(strstr(s->mf.errmsg, "Out of memory in ArrayAlloc"));
+  release_stream(s);
+  puts("reindex: fallback allocation failure reaches caller without retrying completed scan OK");
+}
+
+static void test_segment(void) {
+  static const unsigned char corrupt[] = {0, 0x11,0x4d,0x9b,0x74,0x80,
+                                             0x11,0x4d,0x9b,0x74,0x80,0};
+  static const unsigned char chain[] = {0, 0x11,0x4d,0x9b,0x74,0x8e,0x4d,0xbb,0x8b,
+                                           0x53,0xab,0x84,0x11,0x4d,0x9b,0x74,
+                                           0x53,0xac,0x81,0};
+  struct TestStream *s = make_stream(corrupt, sizeof(corrupt));
+  s->mf.pCluster = 0;
+  if (setjmp(s->mf.jb)) CHECK(!"segment recovery unexpectedly escaped");
+  seek(&s->mf, 1);
+  parseSegment(&s->mf, s->size - 1);
+  CHECK(!(s->mf.flags & MPF_ERROR));
+  release_stream(s);
+
+  s = make_stream(chain, sizeof(chain));
+  s->mf.pCluster = 0;
+  s->read_chunk = 1; /* count all bytes even when the SeekHead points to itself */
+  if (setjmp(s->mf.jb)) CHECK(!"SeekHead chain unexpectedly escaped");
+  seek(&s->mf, 1);
+  parseSegment(&s->mf, s->size - 1);
+  CHECK(s->reads == 195); /* initial 5 bytes + 10*(14 payload + 5 header) */
+  CHECK(filepos(&s->mf) == s->size && s->mf.pSeekHead == 1);
+  release_stream(s);
+  puts("parseSegment: corrupt input recovery and 10-SeekHead chain limit OK");
+}
+
+int main(void) {
+  test_blocks();
+  test_reindex_limit();
+  test_reindex_cue();
+  test_reindex_oom();
+  test_segment();
+  puts("12 Matroska parser recovery scenarios OK");
+  return 0;
+}
