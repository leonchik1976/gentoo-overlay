diff --git a/tests/meson.build b/tests/meson.build
--- a/tests/meson.build
+++ b/tests/meson.build
@@ -86,3 +86,11 @@
 
 test('gtest main', runner, env: {'AEGISUB_TEST_DATA_DIR': meson.current_source_dir()}, depends: test_setup)
 test('luajit-52', executable('luajit-52', 'tests/luajit_52.c', dependencies: luajit))
+
+# Exercise the bundled C parser separately from libaegisub's C++ tests.
+matroska_recovery = executable('matroska-recovery',
+    'tests/matroska_recovery.c',
+    c_args: conf_defines,
