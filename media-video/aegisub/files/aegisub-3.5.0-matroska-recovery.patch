+// The parsing attempt has no setjmp: its locals are discarded on recovery.
+static int readMoreBlocksData(MatroskaFile *mf, int ret) {
+  uint64_t toplen, cstop;
+  int cid;
 
   cstop = mf->cache->getcachesize(mf->cache)>>1;
   if (cstop > MAX_READAHEAD)
@@ -2469,6 +2425,62 @@
 
   mf->readPosition = filepos(mf);
 
+  return ret;
