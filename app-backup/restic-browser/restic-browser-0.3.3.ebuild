# The frontend's runtime-bundled npm dependencies (embedded in the
# installed binary via Tauri's asset system) are Apache-2.0, MIT, or
# BSD-3-Clause -- the latter already covered by the "BSD" crate-license
# entry above (Gentoo's licenses/BSD file is the 3-clause text). This
# notably includes the vendored @vaadin/* family, deliberately pinned to
# 23.3.25 (see the RESTIC_BROWSER_NPM_SRC_URI comment above)
# specifically because 23.5.0+ relicensed those same packages under the
# non-redistributable Vaadin Commercial License and Service Terms
# (https://vaadin.com/commercial-license-and-service-terms).
SLOT="0"
KEYWORDS="~arm64"

# The bundled linux/arm64 npm dependency closure below was resolved for
# glibc (the "-gnu" npm native-addon variants); it does not cover musl.
REQUIRED_USE="elibc_glibc"

# Actual link-time/runtime libraries pulled in by the built Tauri binary
# (confirmed via `readelf -d` NEEDED entries against a real build image;
# see scripts/README.restic-browser.md). Neither an X server nor a specific
# GTK display backend is linked in -- GTK/WebKitGTK select their backend
# (X11 or Wayland) at runtime from whichever the installed gtk+:3/
# webkit-gtk were built with (see their own REQUIRED_USE), so this ebuild
# must not force either one.
COMMON_DEPEND="
	dev-libs/glib:2
	net-libs/libsoup:3.0
	net-libs/webkit-gtk:4.1
	x11-libs/cairo
	x11-libs/gdk-pixbuf:2
	x11-libs/gtk+:3
	x11-libs/pango
"
RDEPEND="
	${COMMON_DEPEND}
	app-backup/restic
"
DEPEND="${COMMON_DEPEND}"
BDEPEND="
	net-libs/nodejs[npm]
"

# Keeps package.json consistent with the actually-vendored node_modules
# (see the RESTIC_BROWSER_NPM_SRC_URI comment above): src_prepare's
# hand-assembled node_modules never reads package.json or package-lock.json,
# so neither this patch nor installing the pinned lockfile below has any
# effect on the build itself, but both leave the unpacked source tree
# accurately declaring the pinned @vaadin/* versions instead of upstream's
# unpinned "^23.3" ranges and commercially-licensed resolutions.
PATCHES=( "${FILESDIR}/${P}-vaadin-23.3.25.patch" )

pkg_setup() {
	# rust.eclass (pulled in via cargo.eclass) normally exports this as
	# pkg_setup itself (sets up CARGO/RUSTC and PATH for the selected Rust
	# slot); defining our own pkg_setup below shadows that unless we call
	# it explicitly.
	rust_pkg_setup

	[[ ${RESTIC_BROWSER_NPM_DEPS_VERSION} == ${PV} ]] ||
		die "RESTIC_BROWSER_NPM_DEPS_VERSION (${RESTIC_BROWSER_NPM_DEPS_VERSION}) does not match PV (${PV}); the pasted-in dependency arrays were generated for a different version"
}

src_prepare() {
	pushd .. >/dev/null || die
	default
	popd >/dev/null || die

	local npm_root="${WORKDIR}/${P}"
	local entry pkgpath filename tmpdir rootdir

	gunzip -c "${FILESDIR}/${P}-vaadin-23.3.25-package-lock.json.gz" \
		> "${npm_root}/package-lock.json" || die

	mkdir "${npm_root}/node_modules" || die
	for entry in "${RESTIC_BROWSER_NPM_PATHS[@]}"; do
		pkgpath=${entry%%|*}
		filename=${entry##*|}
		tmpdir=$(mktemp -d --tmpdir="${T}") || die
		tar -xzf "${DISTDIR}/${filename}" -C "${tmpdir}" || die
		rootdir=$(find "${tmpdir}" -mindepth 1 -maxdepth 1 -type d)
		[[ -n ${rootdir} ]] || die "no top-level directory found in ${filename}"
		mkdir -p "${npm_root}/$(dirname "${pkgpath}")" || die
		mv "${rootdir}" "${npm_root}/${pkgpath}" || die
		rm -rf "${tmpdir}" || die
	done

	# "npm run build" (tsc && vite build) only ever invokes these two
	# binaries directly; everything else (rollup, esbuild) is loaded by
	# vite/tsc as a library, not via PATH, so no full `npm install`
	# bin-linking pass is needed.
	mkdir "${npm_root}/node_modules/.bin" || die
	ln -s ../typescript/bin/tsc "${npm_root}/node_modules/.bin/tsc" || die
	ln -s ../vite/bin/vite.js "${npm_root}/node_modules/.bin/vite" || die
}

src_configure() {
	local myfeatures=(
		custom-protocol
	)
	cargo_src_configure
}

src_compile() {
	pushd .. >/dev/null || die
	npm run build || die
	popd >/dev/null || die

	cargo_src_compile
}

src_install() {
	cargo_src_install

	newicon "${S}/icons/icon.png" "${PN}.png"
	make_desktop_entry "${PN}" Restic-Browser "${PN}"
}
