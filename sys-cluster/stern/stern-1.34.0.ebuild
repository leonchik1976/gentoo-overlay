# Full statically-linked dependency closure verified with dev-go/lichen.
# lichen flags sigs.k8s.io/yaml as partly "ImageMagick"-licensed, but a
# full grep of that module's actual source and GOMODCACHE copy contains
# no such license text anywhere -- a classifier false positive against
# its concatenated MIT+Apache-2.0+BSD-3-Clause LICENSE file, not a real
# license term, so it is deliberately not included here.
LICENSE="Apache-2.0 BSD BSD-2 ISC MIT"
SLOT="0"
KEYWORDS="~amd64 ~arm64"

src_compile() {
	ego build -o "${T}/${PN}" .
}

src_install() {
	dobin "${T}/${PN}"
	dodoc README.md
}
