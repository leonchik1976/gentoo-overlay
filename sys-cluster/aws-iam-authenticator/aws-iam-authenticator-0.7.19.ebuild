# Unlike the -bin packages elsewhere in this overlay, this package
# builds from source using dependencies listed via EGO_SUM above. Its Go
# dependencies are statically incorporated into the resulting binary.
# Full dependency license closure was audited directly against a local
# build with dev-go/lichen. lichen flags
# sigs.k8s.io/yaml as partly "ImageMagick"-licensed, but a full grep of
# that module's actual source (both the tagged release tarball and the
# fetched GOMODCACHE copy) contains no such license text anywhere --
# this is a lichen classifier false positive against its concatenated
# MIT+Apache-2.0+BSD-3-Clause LICENSE file, not a real license term, so
# it is deliberately not included here.
LICENSE="Apache-2.0 BSD ISC MIT"
SLOT="0"
KEYWORDS="~amd64 ~arm64"

BDEPEND=">=dev-lang/go-1.26.0:="

src_prepare() {
	default

	# Upstream ships a go.work workspace that also pulls in the
	# tests/e2e and tests/integration modules (and their test-only
	# deps like ginkgo/gomega). Drop it so the build uses only the
	# root module's go.mod/go.sum, which is what EGO_SUM covers.
	rm -f go.work go.work.sum || die
}

src_compile() {
	ego build -ldflags="-s -w" -o bin/${PN} ./cmd/aws-iam-authenticator/
}

src_install() {
	dobin bin/${PN}
}
