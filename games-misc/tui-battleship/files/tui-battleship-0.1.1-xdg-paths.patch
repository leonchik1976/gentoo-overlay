+function init_paths()
+{
+ if ! mkdir -p "$CONFIG_DIR" "$STATE_DIR"
+ then
+  echo "tui-battleship: could not create $CONFIG_DIR or $STATE_DIR." >&2
+  exit 1
+ fi
+ if [[ ! -f "$CONFIG_FILE" ]]&&! cp "$ASSET_DIR/tui-battleship.config" "$CONFIG_FILE"
+ then
+  echo "tui-battleship: could not create default configuration file at $CONFIG_FILE." >&2
+  exit 1
+ fi
+ if [[ ! -f "$LOG_FILE" ]]&&! : >"$LOG_FILE"
+ then
+  echo "tui-battleship: could not create log file at $LOG_FILE." >&2
+  exit 1
+ fi
+ if [[ ! -f "$HISCORES_FILE" ]]&&! : >"$HISCORES_FILE"
+ then
+  echo "tui-battleship: could not create high-score file at $HISCORES_FILE." >&2
+  exit 1
+ fi
+}
