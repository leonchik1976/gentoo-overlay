+const { promisify } = require("node:util");
 async function extractElectronZip(zipPath, targetDir) {
-    await (0, extract_zip_1.default)(zipPath, { dir: targetDir });
+    await promisify(execFile)("unzip", ["-q", zipPath, "-d", targetDir]);
