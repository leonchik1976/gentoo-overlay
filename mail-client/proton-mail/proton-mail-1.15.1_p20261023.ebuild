for npm_package in "${NPM_PACKAGES[@]}"; do
	npm_name=${npm_package%@*}
	npm_version=${npm_package##*@}
	npm_archive=${npm_name//@/}
	npm_archive=${npm_archive//\//-}
	SRC_URI+="
		https://registry.npmjs.org/${npm_name}/-/${npm_name##*/}-${npm_version}.tgz ->
			${PN}-npm-${npm_archive}-${npm_version}.tgz
	"
done
unset NPM_PACKAGES npm_package npm_name npm_version npm_archive

S="${WORKDIR}/WebClients-${MY_COMMIT}"

# Includes the bundled Electron/Chromium libraries; retain their notices.
LICENSE="Apache-2.0 BSD BSD-2 GPL-3 ISC LGPL-2.1+ MIT MPL-2.0 ZLIB"
SLOT="0"
KEYWORDS="~arm64"
IUSE="test"
RESTRICT="!test? ( test ) strip"

BDEPEND+="

	${PYTHON_DEPS}
	$(python_gen_any_dep 'dev-python/pyyaml[${PYTHON_USEDEP}]')
	app-arch/unzip
	>=net-libs/nodejs-24.22.1
	<net-libs/nodejs-25
"
RDEPEND="
	!mail-client/proton-mail-bin
	app-accessibility/at-spi2-core:2
	dev-libs/expat
	dev-libs/glib:2
	dev-libs/nspr
	dev-libs/nss
	media-libs/alsa-lib
	media-libs/mesa[opengl]
	net-print/cups
	sys-apps/dbus
	sys-libs/glibc
	virtual/udev
	x11-libs/cairo
	x11-libs/gtk+:3
	x11-libs/libX11
	x11-libs/libXcomposite
	x11-libs/libXdamage
	x11-libs/libXext
	x11-libs/libXfixes
	x11-libs/libXrandr
	x11-libs/libxcb:=
	x11-libs/libxkbcommon
	x11-libs/pango
"
IDEPEND="dev-util/desktop-file-utils"
QA_PREBUILT="opt/proton-mail/*"

python_check_deps() {
	python_has_version "dev-python/pyyaml[${PYTHON_USEDEP}]"
}

src_unpack() {
	unpack "${P}.tar.gz"
	mkdir "${WORKDIR}/pnpm" || die
	tar -xzf "${DISTDIR}/${P}-pnpm.tgz" -C "${WORKDIR}/pnpm" || die
}

src_prepare() {
	default
	"${PYTHON}" "${FILESDIR}/proton-mail-offline.py" "${S}" "${DISTDIR}" || die
}

proton_pnpm() {
	PATH="${WORKDIR}/pnpm/package:${PATH}" "${WORKDIR}/pnpm/package/pnpm" \
		--config.manage-package-manager-versions=false \
		--config.engine-strict=false \
		--config.trust-lockfile=true \
		--store-dir "${WORKDIR}/pnpm-store" "$@" || die
}

src_configure() {
	chromium_suid_sandbox_check_kernel_config
	# pnpm opens many local archives concurrently during an offline install.
	ulimit -n 8192 || die "pnpm needs an open-file limit of at least 8192"
	export CI=true ELECTRON_SKIP_BINARY_DOWNLOAD=1
	export XDG_CACHE_HOME="${T}/cache"
	export PROTON_ELECTRON_ZIP_DIR="${DISTDIR}"
	# Portage authenticates all archives; retain upstream lockfile integrity
	# checks while trusting its resolutions redirected to local files.
	# Ignore lifecycle scripts: they include Electron downloads and unrelated
	# workspace setup. Forge compiles the desktop application in src_compile.
	proton_pnpm --filter proton-inbox-desktop... install \
		--offline --frozen-lockfile --ignore-scripts
	if use test; then
		# SWC injects core-js imports into sources in other workspaces.
		ln -s ../packages/jest-swc-preset/node_modules/core-js node_modules/core-js || die
	fi
	# Use the system ZIP extractor for the already-fetched Electron runtime.
	local packager_dir
	for packager_dir in node_modules/.pnpm/@electron+packager@18.3.5*/node_modules/@electron/packager/dist; do
		pushd "${packager_dir}" >/dev/null || die
		eapply "${FILESDIR}/proton-mail-system-unzip.patch"
		popd >/dev/null || die
	done
}

src_compile() {
	cd applications/inbox-desktop || die
	RELEASE=stable SKIP_CODESIGN=true proton_pnpm exec electron-forge package --platform=linux --arch=arm64
	[[ -f "out/Proton Mail-linux-arm64/resources/app.asar" ]] || die "Forge did not produce the application"
}

src_test() {
	cd applications/inbox-desktop || die
	# The carrier rejects Portage's group-writable build ancestors. Materialize
	# it once in its verified, per-user namespace under root's sticky /tmp.
	# The preload restores TMPDIR before Jest or the tests can use it.
	addwrite "/tmp/swc-native-${EUID}"
	unset SWC_NATIVE_BINDING_CACHE_SKIP_SECURITY_CHECK
	node --require "${FILESDIR}/proton-mail-swc-preload.cjs" \
		node_modules/jest/bin/jest.js --runInBand || die "Desktop tests failed"
}

src_install() {
	local app="applications/inbox-desktop/out/Proton Mail-linux-arm64"
	insinto /opt/proton-mail
	doins -r "${app}/."
	fperms 0755 "/opt/proton-mail/Proton Mail" \
		/opt/proton-mail/{chrome-sandbox,chrome_crashpad_handler}
	fowners root:root /opt/proton-mail/chrome-sandbox
	fperms 4711 /opt/proton-mail/chrome-sandbox
	dosym -r "/opt/proton-mail/Proton Mail" /usr/bin/proton-mail
	newicon applications/inbox-desktop/assets/icons/icon.png proton-mail.png
	make_desktop_entry --eapi9 proton-mail --name "Proton Mail" \
		--args '%U' --icon proton-mail --categories 'Network;Email;' \
		--entry 'MimeType=x-scheme-handler/mailto;'
	dodoc LICENSE
}

pkg_postinst() {
	xdg_desktop_database_update
}

pkg_postrm() {
	xdg_desktop_database_update
}
