"

LICENSE="MIT Apache-2.0 BSD BSD-2 MPL-2.0"
SLOT="0"
KEYWORDS="~amd64 ~arm64"

BDEPEND=">=dev-lang/go-1.25.7:="

src_compile() {
	ego build -ldflags="-s -w" -o "${PN}" ./cmd/granted
}

src_install() {
	dobin "${PN}"
	dosym "${PN}" /usr/bin/assumego

	insinto /usr/share/${PN}
	doins scripts/assume scripts/assume.fish scripts/assume.tcsh

	dodoc README.md
}

pkg_postinst() {
	elog "granted itself only assumes roles for the 'assumego' helper binary."
	elog "To get 'assume' as a shell function that can export AWS credentials"
	elog "into your current shell, source the script matching your shell from"
	elog "/usr/share/${PN}/, e.g. for bash/zsh add to your rc file:"
	elog "  source /usr/share/${PN}/assume"
	elog "For fish: source /usr/share/${PN}/assume.fish"
	elog "For tcsh: source /usr/share/${PN}/assume.tcsh"
}
