+"""Regression coverage for the downstream Rich separator compatibility change."""
+import io
+
+import pytest
+from rich.console import Console
+from rich.rule import Rule
+
+from mcp_client_for_ollama.utils.markdown import Markdown
+
+
+@pytest.mark.parametrize("width", [1, 20, 40, 80, 120])
+@pytest.mark.parametrize("marker", ["---", "***", "___"])
+def test_markdown_rule_characters_style_spacing(width, marker):
+    console = Console(width=width, force_terminal=True, color_system="standard")
+    segments = list(console.render(Markdown(marker), console.options))
+    text = "".join(segment.text for segment in segments)
+    assert text == "─" * width + "\n"
+    painted = [segment for segment in segments if "─" in segment.text]
+    assert painted
+    assert all(segment.style.color.name == "yellow" for segment in painted)
+    assert all(not segment.style.dim for segment in painted)
+
+
+@pytest.mark.parametrize("width", [1, 20, 40, 80, 120])
+def test_standalone_rule_characters_style_spacing(width):
+    console = Console(width=width, force_terminal=True, color_system="standard")
+    segments = list(console.render(Rule(characters="─", style="yellow")))
+    assert "".join(segment.text for segment in segments) == "─" * width + "\n"
+    assert all(segment.style.color.name == "yellow" for segment in segments if "─" in segment.text)
+
+
+def test_horizontal_rule_in_body_and_code_block():
+    stream = io.StringIO()
+    console = Console(file=stream, width=20, color_system=None)
+    console.print(Markdown("before\n\n---\n\nafter"))
+    assert stream.getvalue().splitlines() == ["before              ", "", "─" * 20, "after               "]
+    stream.seek(0)
+    stream.truncate()
+    console.print(Markdown("```text\n---\n```"))
+    assert "---" in stream.getvalue()
+    assert "─" not in stream.getvalue()
+
+
+@pytest.mark.parametrize("width", [1, 20, 40, 80, 120])
+def test_actual_streaming_separators(width):
+    import asyncio
+    from types import SimpleNamespace
+    from unittest.mock import MagicMock, patch
+    from mcp_client_for_ollama.utils.streaming import StreamingManager
+
+    console = MagicMock()
+    manager = StreamingManager(console)
+
+    async def stream():
+        yield SimpleNamespace(choices=[SimpleNamespace(
+            delta=SimpleNamespace(content="answer", reasoning="thought", tool_calls=None),
+            finish_reason=None,
+        )])
+
+    with patch("mcp_client_for_ollama.utils.streaming.extract_metrics", return_value=None):
+        asyncio.run(manager.process_streaming_response(
+            stream(), thinking_mode=True, show_thinking=True, answer_render_mode="plain",
+        ))
+    calls = console.print.call_args_list
+    rules = [(i, call.args[0]) for i, call in enumerate(calls)
+             if call.args and isinstance(call.args[0], Rule)]
+    assert len(rules) == 2  # Thinking header and answer transition.
+    renderer = Console(width=width, force_terminal=True, color_system="standard")
+    for i, rule in rules:
+        segments = list(renderer.render(rule))
+        assert "".join(segment.text for segment in segments) == "─" * width + "\n"
+        assert all(segment.style.color.name == "yellow" for segment in segments if "─" in segment.text)
+        assert calls[i + 1].args == ()  # Existing deliberate blank line, exactly once.
