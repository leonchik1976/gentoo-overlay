+"""Keep Markdown separators stable across the supported Rich versions."""
+
+from rich.markdown import HorizontalRule, Markdown as RichMarkdown
+from rich.rule import Rule
+
+
+class _HorizontalRule(HorizontalRule):
+    def __rich_console__(self, console, options):
+        # Rich 14.3 changed the glyph, style and trailing blank line.
+        yield Rule(characters="─", style="yellow")
+
+
+class Markdown(RichMarkdown):
+    # Copy the mapping: never change Rich's global renderer registrations.
+    elements = {**RichMarkdown.elements, "hr": _HorizontalRule}
