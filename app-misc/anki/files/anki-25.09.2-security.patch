+def _untrusted_page_content_security_policy(script_src: str) -> str:
+    """CSP for pages that show user content, e.g. note fields in the editor."""
+    return "; ".join(
+        (
+            f"script-src {script_src}",
+            "form-action 'none'",
+            TRUSTED_PAGE_CSP,
+        )
+    )
