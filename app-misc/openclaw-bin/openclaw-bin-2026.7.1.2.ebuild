SRC_URI="
	https://registry.npmjs.org/openclaw/-/openclaw-${MY_PV}.tgz -> ${P}.tgz
	${OPENCLAW_NPM_SRC_URI[*]}
	amd64? ( ${OPENCLAW_NPM_SRC_URI_AMD64[*]} )
	arm64? ( ${OPENCLAW_NPM_SRC_URI_ARM64[*]} )
"
S="${WORKDIR}/package"

# openclaw itself is MIT. The vendored npm dependency closure's licenses
# (deduplicated from npm-shrinkwrap.json's per-package "license" fields):
# Apache-2.0, (BSD-3-Clause as) BSD, BSD-2-Clause (as BSD-2),
# BlueOak-1.0.0, ISC, MPL-2.0, 0BSD, Unlicense, (MIT AND Zlib) (as MIT +
# ZLIB), (MIT OR GPL-3.0-or-later), and (MIT OR Apache, i.e. Apache-2.0).
LICENSE="
	MIT
	Apache-2.0 BSD BSD-2 BlueOak-1.0.0 ISC MPL-2.0 0BSD Unlicense ZLIB
	|| ( MIT GPL-3+ )
	|| ( MIT Apache-2.0 )
"
SLOT="0"
KEYWORDS="~amd64 ~arm64"

# ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0" per package.json "engines".
RDEPEND="
	|| (
		( >=net-libs/nodejs-22.22.3 <net-libs/nodejs-23 )
		( >=net-libs/nodejs-24.15.0 <net-libs/nodejs-25 )
		>=net-libs/nodejs-25.9.0
	)
"
# Build-time only: _openclaw_safe_extract (below) needs a Python interpreter
# for its tarfile-based safe extraction; nothing installed by this package
# imports or runs Python at runtime.
BDEPEND="${PYTHON_DEPS}"

MY_PN="openclaw"

pkg_setup() {
	[[ ${OPENCLAW_NPM_DEPS_VERSION} == ${PV} ]] ||
		die "OPENCLAW_NPM_DEPS_VERSION (${OPENCLAW_NPM_DEPS_VERSION}) does not match PV (${PV}); the pasted-in dependency arrays were generated for a different version"

	# python-any-r1.eclass EXPORT_FUNCTIONS pkg_setup; defining our own
	# pkg_setup (for the version check above) shadows that unless called
	# explicitly. Populates ${EPYTHON}, used by _openclaw_safe_extract.
	python-any-r1_pkg_setup
}

# A handful of published npm tarballs in this dependency closure (observed
# with pngjs-5.0.0) record directory entries with a broken mode (no
# execute bit for anyone at all -- likely an artifact of whatever tool
# originally packed them), which leaves the extracted directory
# untraversable: archived-mode & ~umask can never add back a missing
# execute bit. GNU tar applies that broken mode unconditionally --
# neither --no-same-permissions nor --no-overwrite-dir prevents it -- and
# aborts extraction partway through with "Cannot open: Permission denied"
# on every entry still to come in that same archive. Python's tarfile
# lets each member's mode be fixed up before extraction instead, so every
# tarball in this ebuild is extracted this way (not just the one known to
# need it, in case a future version bump reveals another affected
# package) rather than plain `tar`/unpack. OR-ing in rather than
# replacing the mode preserves genuinely-set executable bits (e.g.
# openclaw.mjs's).
#
# These are third-party tarballs pulled from the public npm registry, not
# fully trusted input, so extraction also passes tarfile.data_filter (the
# PEP 706 safe-extraction filter: rejects absolute paths, "../" traversal,
# symlinks/hardlinks/device files that would land outside the destination,
# and strips setuid/setgid/sticky bits) in addition to -- not instead of
# -- the manual mode fixup above; verified empirically (see the commit
# introducing this) that combining both on all 300 currently-vendored
# tarballs, including the broken-permission pngjs one, extracts cleanly
# with no rejections.
_openclaw_safe_extract() {
	local archive=$1 dest=$2
	"${EPYTHON}" -c '
import sys, tarfile
with tarfile.open(sys.argv[1]) as t:
	members = t.getmembers()
	for m in members:
		m.mode |= 0o700 if m.isdir() else 0o600
	t.extractall(sys.argv[2], members=members, filter=tarfile.data_filter)
' "${archive}" "${dest}" || die "failed to extract ${archive}"
}

# Extracts one vendored npm dependency tarball (whose top-level directory
# is always the literal name "package", same as ${P}.tgz's own) directly
# into node_modules/<pkgpath> -- no `npm install` invocation, so no
# network access is needed at any build phase. Mirrors
# app-backup/restic-browser's src_prepare loop.
_openclaw_vendor_npm_path() {
	local entry=$1 pkgpath filename tmpdir rootdir
	pkgpath=${entry%%|*}
	filename=${entry##*|}
	tmpdir=$(mktemp -d --tmpdir="${T}") || die
	_openclaw_safe_extract "${DISTDIR}/${filename}" "${tmpdir}"
	rootdir=$(find "${tmpdir}" -mindepth 1 -maxdepth 1 -type d)
	[[ -n ${rootdir} ]] || die "no top-level directory found in ${filename}"
	mkdir -p "${S}/$(dirname "${pkgpath}")" || die
	mv "${rootdir}" "${S}/${pkgpath}" || die
	rm -rf "${tmpdir}" || die
}

src_unpack() {
	_openclaw_safe_extract "${DISTDIR}/${P}.tgz" "${WORKDIR}"
}

src_prepare() {
	default

	mkdir "${S}/node_modules" || die

	local entry
	for entry in "${OPENCLAW_NPM_PATHS[@]}"; do
		_openclaw_vendor_npm_path "${entry}"
	done

	local node_arch arch_paths=()
	case ${ARCH} in
		amd64) node_arch="x64"; arch_paths=( "${OPENCLAW_NPM_PATHS_AMD64[@]}" ) ;;
		arm64) node_arch="arm64"; arch_paths=( "${OPENCLAW_NPM_PATHS_ARM64[@]}" ) ;;
		*) die "unsupported ARCH: ${ARCH}" ;;
	esac
	local arch_entry
	for arch_entry in "${arch_paths[@]}"; do
		_openclaw_vendor_npm_path "${arch_entry}"
	done

	# Unlike @lydell/node-pty/sqlite-vec (one npm package per platform,
	# already handled above by only ever vendoring the matching variant),
	# tree-sitter-bash bundles prebuilt native addons for every platform
	# inside a single npm package. Strip the ones that can never run here
	# so the image doesn't ship dead-arch ELF objects (which also trips a
	# spurious QA soname-resolution warning on the foreign-arch .node).
	local tsb="${S}/node_modules/tree-sitter-bash/prebuilds" keep="linux-${node_arch}" d
	if [[ -d ${tsb} ]]; then
		for d in "${tsb}"/*/; do
			d=${d%/}
			[[ $(basename "${d}") == "${keep}" ]] || rm -rf "${d}" || die
		done
	fi
}

src_install() {
	local installdir="/usr/lib/node_modules/${MY_PN}"

	insinto "${installdir}"
	doins -r dist skills docs src patches node_modules
	doins package.json npm-shrinkwrap.json pnpm-workspace.yaml \
		LICENSE THIRD_PARTY_NOTICES.md

	exeinto "${installdir}"
	doexe openclaw.mjs

	dosym -r "${installdir}/openclaw.mjs" /usr/bin/openclaw

	dodoc "${FILESDIR}/${P}-third-party-licenses.txt"

	einstalldocs
}
