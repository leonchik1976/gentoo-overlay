Use the existing child-process fallback for the native compiler.
Node process.execve races with Gentoo sandbox ptrace mode closing descriptors
in a multithreaded process: https://bugs.gentoo.org/974609 (CONFIRMED).

--- a/lib/tsc.js
+++ b/lib/tsc.js
@@ -4,16 +4,6 @@
 import { execFileSync } from "node:child_process";
 
 const exe = getExePath();
-
-if (process.platform !== "win32" && typeof process.execve === "function") {
-    // > v22.15.0
-    try {
-        process.execve(exe, [exe, ...process.argv.slice(2)]);
-    }
-    catch {
-        // may not be available, ignore the error and fallback
-    }
-}
 
 try {
     execFileSync(exe, process.argv.slice(2), { stdio: "inherit" });
